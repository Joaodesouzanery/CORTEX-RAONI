NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Obrigatórias em produção. Em desenvolvimento, podem ficar ausentes.
# APP_PASSWORD protege toda a interface de operador.
# CRON_SECRET protege coleta, alertas e o worker mensal.
# APP_PASSWORD=uma-senha-forte
# CRON_SECRET=outro-segredo-longo-e-aleatorio

# Opcional — necessário somente para geração real de relatórios via IA
# Sem esta variável, o sistema usa modo mock (relatório de demonstração)
# ANTHROPIC_API_KEY=sk-ant-...

# Necessárias na Vercel para o botão "Fechar mês"/"Regenerar" disparar Actions.
# Use um fine-grained token restrito ao repositório, com Actions: write.
# GITHUB_ACTIONS_TOKEN=github_pat_...
# GITHUB_REPOSITORY=organizacao/repositorio
# GITHUB_WORKFLOW_REF=main

# Opcional — liga o envio do digest de alertas por e-mail (Resend, via HTTP).
# Sem estas variáveis, /api/alerts/check calcula os alertas e os RETORNA (não envia).
# ALERTS_EMAIL_TO deve ser o(s) destinatário(s), separados por vírgula.
# RESEND_API_KEY=re_...
# ALERTS_EMAIL_TO=voce@sauz.com.br
# ALERTS_EMAIL_FROM=CORTEX <alertas@seudominio.com.br>
