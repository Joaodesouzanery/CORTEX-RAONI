NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Opcional — necessário somente para geração real de relatórios via IA
# Sem esta variável, o sistema usa modo mock (relatório de demonstração)
# ANTHROPIC_API_KEY=sk-ant-...

# Opcional — protege os endpoints de cron (busca de notícias e alertas)
# CRON_SECRET=seu-segredo-aqui

# Opcional — liga o envio do digest de alertas por e-mail (Resend, via HTTP).
# Sem estas variáveis, /api/alerts/check calcula os alertas e os RETORNA (não envia).
# ALERTS_EMAIL_TO deve ser o(s) destinatário(s), separados por vírgula.
# RESEND_API_KEY=re_...
# ALERTS_EMAIL_TO=voce@sauz.com.br
# ALERTS_EMAIL_FROM=CORTEX <alertas@seudominio.com.br>

